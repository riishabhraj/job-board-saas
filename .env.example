# Public contact address. When set, the Contact page and footer link appear.
# Not a secret: it is shown on the site. Set it in the Vercel project env vars.
NEXT_PUBLIC_CONTACT_EMAIL=

# PostHog project key (public by design; it ships to the browser). Product
# analytics stay off when this is empty. Set it in the Vercel project env vars.
NEXT_PUBLIC_POSTHOG_KEY=
